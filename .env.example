# Copy to .env; never commit real credentials.
OWL_PROVIDER=ollama
OWL_MODE=assistant
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Direct Ollama Cloud (opt-in; charges may apply).
OLLAMA_CLOUD_MODEL=gemma4:31b
# OLLAMA_API_KEY=

# AWS Bedrock API-key authentication. The pinned CAMEL adapter is not SigV4.
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=
# BEDROCK_API_KEY=

# Enable only if read-only public search is needed in workforce mode.
OWL_ENABLE_WEB_SEARCH=0
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
